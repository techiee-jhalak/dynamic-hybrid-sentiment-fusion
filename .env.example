# ===========================================================================
# Dynamic Hybrid Sentiment Fusion — Environment Configuration
# ===========================================================================

# Path to the fine-tuned SentiMix 3-class DistilBERT checkpoint directory
# Defaults to saved_models/sentimix_distilbert_best if unset
SENTIMIX_MODEL_PATH=saved_models/sentimix_distilbert_best

# Computation device for transformer inference: 'cpu' or 'cuda'
# Defaults to 'cuda' if GPU is available, otherwise 'cpu'
INFERENCE_DEVICE=cpu

# Allowed CORS origins for the FastAPI application (comma-separated)
# In production, set to your exact domain (e.g., https://sentiment.yourdomain.com)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Maximum character budget for input texts (default: 2048)
API_MAX_TEXT_CHARS=2048

# Server network settings
HOST=127.0.0.1
PORT=8000
